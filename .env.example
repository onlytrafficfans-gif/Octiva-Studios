# Octiva core
OCTIVA_ENGINE_TIMEOUT=1800

# Workspace convention:
#   <parent>/Octiva-Studios
#   <parent>/octiva-engines/<engine>
# Wrapper commands execute with the engine checkout as cwd, so ../../Octiva-Studios is intentional.

# ACE-Step 1.5
OCTIVA_ACE_REPO=../octiva-engines/ACE-Step-1.5
OCTIVA_ACE_API=http://127.0.0.1:8001
OCTIVA_ACE_COMMAND=python ../../Octiva-Studios/adapters/ace_step/wrapper.py
OCTIVA_ACE_CHECKPOINT=acestep-v15-turbo

# LeVo 2 / SongGeneration 2
OCTIVA_LEVO_REPO=../octiva-engines/SongGeneration
OCTIVA_LEVO_COMMAND=python ../../Octiva-Studios/adapters/levo2/wrapper.py
OCTIVA_LEVO_CHECKPOINT=SongGeneration-v2-large
OCTIVA_LEVO_CKPT_PATH=
OCTIVA_LEVO_LOW_MEM=0
OCTIVA_LEVO_DISABLE_FLASH_ATTN=0

# DiffRhythm 2
OCTIVA_DIFFRHYTHM_REPO=../octiva-engines/DiffRhythm2
OCTIVA_DIFFRHYTHM_COMMAND=python ../../Octiva-Studios/adapters/diffrhythm2/wrapper.py
OCTIVA_DIFFRHYTHM_CHECKPOINT=ASLP-lab/DiffRhythm2
OCTIVA_DIFFRHYTHM_CFG=2.0
