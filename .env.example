# Octiva core
OCTIVA_ENGINE_TIMEOUT=1800

# ACE-Step 1.5
OCTIVA_ACE_REPO=../octiva-engines/ACE-Step-1.5
OCTIVA_ACE_API=http://127.0.0.1:8001
OCTIVA_ACE_COMMAND=python ../Octiva-Studios/adapters/ace_step/wrapper.py
OCTIVA_ACE_CHECKPOINT=acestep-v15-turbo

# LeVo 2 — set only after native command is verified on target hardware
OCTIVA_LEVO_REPO=../octiva-engines/SongGeneration
OCTIVA_LEVO_COMMAND=
OCTIVA_LEVO_CHECKPOINT=SongGeneration-v2-large

# DiffRhythm 2 — set only after native command is verified on target hardware
OCTIVA_DIFFRHYTHM_REPO=../octiva-engines/DiffRhythm2
OCTIVA_DIFFRHYTHM_COMMAND=
OCTIVA_DIFFRHYTHM_CHECKPOINT=
